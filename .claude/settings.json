{
  "permissions": {
    "allow": [
      "Bash(pixi run *)",
      "Bash(pixi task *)",
      "Bash(pixi --version)",
      "Bash(bazel test *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(bazel build *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(tree *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(diff *)",
      "Bash(which *)",
      "Bash(pwd)",
      "Bash(realpath *)",
      "Bash(du *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git ls-files *)",
      "Bash(bazel query *)",
      "Bash(bazel info *)",
      "Bash(pixi list *)",
      "Bash(pixi info *)",
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo fmt *)",
      "Bash(git check-ignore *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && pixi run fmt >/dev/null 2>&1 || true",
            "statusMessage": "Formatting with pixi run fmt",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
